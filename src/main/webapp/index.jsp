<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CineVerse - Stream Your World</title>

    <link rel="stylesheet"
          href="css/style.css">
</head>

<body>

    <!-- Navigation -->
    <header class="navbar">

        <div class="logo">
            <span>🎬</span> CineVerse
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#trending">Trending</a>
            <a href="#movies">Movies</a>
            <a href="#series">Series</a>
            <a href="#genres">Genres</a>
        </nav>

        <div class="nav-actions">
            <button class="search-btn">🔍</button>
            <button class="profile-btn">👤</button>
        </div>

    </header>


    <!-- Hero Section -->
    <section class="hero" id="home">

        <div class="hero-content">

            <span class="badge">🔥 #1 TRENDING THIS WEEK</span>

            <h1>
                ENTER THE<br>
                <span>CINEVERSE</span>
            </h1>

            <p>
                Discover unforgettable stories, legendary characters,
                and blockbuster entertainment all in one place.
            </p>

            <div class="hero-buttons">
                <button class="watch-btn">
                    ▶ Watch Now
                </button>

                <button class="info-btn">
                    + My List
                </button>
            </div>

            <div class="movie-info">
                <span>⭐ 9.2/10</span>
                <span>2026</span>
                <span>2h 18m</span>
                <span>Action</span>
                <span>Drama</span>
            </div>

        </div>

    </section>


    <!-- Trending -->
    <section class="content-section" id="trending">

        <div class="section-heading">
            <div>
                <span class="section-label">WHAT'S HOT</span>
                <h2>Trending Now</h2>
            </div>

            <a href="#">View All →</a>
        </div>

        <div class="movie-grid">

            <div class="movie-card">
                <div class="poster poster-one">
                    <span class="rank">01</span>
                    <span class="quality">4K</span>
                </div>
                <h3>Shadow Protocol</h3>
                <p>Action • Thriller</p>
                <span class="rating">⭐ 8.9</span>
            </div>

            <div class="movie-card">
                <div class="poster poster-two">
                    <span class="rank">02</span>
                    <span class="quality">4K</span>
                </div>
                <h3>Neon Horizon</h3>
                <p>Sci-Fi • Adventure</p>
                <span class="rating">⭐ 8.7</span>
            </div>

            <div class="movie-card">
                <div class="poster poster-three">
                    <span class="rank">03</span>
                    <span class="quality">HD</span>
                </div>
                <h3>Last Kingdom</h3>
                <p>Drama • History</p>
                <span class="rating">⭐ 8.6</span>
            </div>

            <div class="movie-card">
                <div class="poster poster-four">
                    <span class="rank">04</span>
                    <span class="quality">4K</span>
                </div>
                <h3>Midnight Run</h3>
                <p>Crime • Mystery</p>
                <span class="rating">⭐ 8.4</span>
            </div>

        </div>

    </section>


    <!-- Featured -->
    <section class="featured">

        <div class="featured-content">

            <span class="section-label">CINEVERSE ORIGINAL</span>

            <h2>Beyond The Horizon</h2>

            <p>
                A group of explorers discovers a mysterious world beyond
                the boundaries of known space. Their journey will change
                humanity forever.
            </p>

            <div class="movie-info">
                <span>⭐ 9.1/10</span>
                <span>2026</span>
                <span>2h 34m</span>
            </div>

            <button class="watch-btn">
                ▶ Start Watching
            </button>

        </div>

    </section>


    <!-- Popular Movies -->
    <section class="content-section" id="movies">

        <div class="section-heading">
            <div>
                <span class="section-label">EXPLORE</span>
                <h2>Popular Movies</h2>
            </div>

            <a href="#">View All →</a>
        </div>

        <div class="movie-grid">

            <div class="movie-card">
                <div class="poster poster-five">
                    <span class="quality">4K</span>
                </div>
                <h3>Empire Rising</h3>
                <p>Action • Drama</p>
                <span class="rating">⭐ 9.0</span>
            </div>

            <div class="movie-card">
                <div class="poster poster-six">
                    <span class="quality">HD</span>
                </div>
                <h3>Dark Secrets</h3>
                <p>Mystery • Thriller</p>
                <span class="rating">⭐ 8.8</span>
            </div>

            <div class="movie-card">
                <div class="poster poster-seven">
                    <span class="quality">4K</span>
                </div>
                <h3>Lost Planet</h3>
                <p>Sci-Fi • Adventure</p>
                <span class="rating">⭐ 8.5</span>
            </div>

            <div class="movie-card">
                <div class="poster poster-eight">
                    <span class="quality">HD</span>
                </div>
                <h3>Final Mission</h3>
                <p>Action • War</p>
                <span class="rating">⭐ 8.3</span>
            </div>

        </div>

    </section>


    <!-- Genres -->
    <section class="genres" id="genres">

        <span class="section-label">BROWSE BY</span>
        <h2>Explore Genres</h2>

        <div class="genre-grid">

            <div class="genre-card">🔥 Action</div>
            <div class="genre-card">🚀 Sci-Fi</div>
            <div class="genre-card">❤️ Romance</div>
            <div class="genre-card">👻 Horror</div>
            <div class="genre-card">😂 Comedy</div>
            <div class="genre-card">🕵️ Thriller</div>

        </div>

    </section>


    <!-- Footer -->
    <footer>

        <div class="footer-logo">
            🎬 CineVerse
        </div>

        <p>
            Your universe of entertainment.
        </p>

        <div class="footer-links">
            <a href="#">About</a>
            <a href="#">Privacy</a>
            <a href="#">Terms</a>
            <a href="#">Contact</a>
        </div>

        <p class="copyright">
            © 2026 CineVerse. All rights reserved.
        </p>

    </footer>
    <script src="js/script.js"></script>
</body>
</html>
